# Twilio (SMS) — https://console.twilio.com
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH=your_twilio_auth_token
TWILIO_NUMBER=+15551234567

# Vapi (AI phone calls) — https://dashboard.vapi.ai
VAPI_TOKEN=your_vapi_private_token
VAPI_PHONE_ID=your_vapi_phone_number_id

# Optional: public URL of the end-of-call webhook (src/webhook.js, port 3117).
# When set, make_call tells Vapi to POST server messages here. Use a tunnel
# (e.g. ngrok) in development: WEBHOOK_URL=https://<subdomain>.ngrok.io/vapi/webhook
# WEBHOOK_URL=

# Optional: path to the SQLite database file (defaults to ./contacts.db)
# PHONE_AGENT_DB=./contacts.db

# --- Dashboard authentication (src/webhook.js) ---
# Single admin login for the dashboard and /api routes. Generate the hash with:
#   npm run hash-password -- 'your-password'
# The dashboard and /api are locked until both are set.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=
# Optional: explicit secret for signing session cookies. If unset, it is derived
# from the password hash (so changing the password logs everyone out).
# SESSION_SECRET=
# Optional: force the Secure flag on the session cookie (set true behind HTTPS).
# DASHBOARD_SECURE_COOKIE=false

# --- Webhook verification ---
# Shared secret sent by Vapi as the `x-vapi-secret` header. When set, make_call
# adds it to the assistant's server config and /vapi/webhook rejects requests
# that don't carry a matching value. Use a long random string.
# VAPI_WEBHOOK_SECRET=

# --- Inbound trigger endpoint (POST /api/trigger/call) ---
# Bearer token external systems must send as `Authorization: Bearer <key>`.
# The endpoint is disabled (503) until this is set. Use a long random string.
# TRIGGER_API_KEY=
# Optional: business-hours window ("HH:MM-HH:MM"). Calls triggered outside it are
# queued until the window reopens (or rejected if the request sends
# {"outside_hours":"reject"}). When unset, calls are placed at any hour.
# CALL_HOURS=08:00-19:00
# Optional: IANA time zone the window is evaluated in (default America/Chicago).
# CALL_TIMEZONE=America/Chicago
# Optional: max accepted triggers per rolling hour (default 30).
# TRIGGER_RATE_MAX=30
